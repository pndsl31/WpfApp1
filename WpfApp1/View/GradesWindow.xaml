<Window x:Class="WpfApp1.View.GradesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.View"
        mc:Ignorable="d"
        Title="GradesWindow" Height="600" Width="1000" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="111*"/>
                <ColumnDefinition Width="50*"/>
            </Grid.ColumnDefinitions>
            <Grid.Background>
                <ImageBrush ImageSource="..\Images\backgroundImage.jpg"/>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height= "15"/>
                <RowDefinition Height= "25"/>
                <RowDefinition/>
                <RowDefinition Height=" 40"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1" Grid.ColumnSpan="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="HomeButton" 
                    Grid.Column="0" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    BorderBrush="{x:Null}"
                    Command="{Binding Navigation.GoToMainDashboardCommand}"
                    Width="40" 
                    Height="40">
                    <Button.Content>
                        <Image x:Name="HOME_PAGE_BUTTON" 
                           Source="../Images/P-removebg-preview.png" 
                           Width="30" 
                           Height="30"/>
                    </Button.Content>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>


                <Menu Grid.Column="3" 
                  HorizontalAlignment="Center" 
                  Background="{x:Null}">
                    <MenuItem x:Name="SubjectsWindow" 
                          Header="Subjects"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12" 
                          Command="{Binding Navigation.GoToSubjectsCommand}"/>
                </Menu>

                <Menu Grid.Column="4" 
                  HorizontalAlignment="Center" 
                  Background="{x:Null}">
                    <MenuItem x:Name="GradesMenu" 
                          Header="Grades"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12" 
                          />
                </Menu>

                <Menu Grid.Column="5" 
                      HorizontalAlignment="Center" 
                      Background="{x:Null}">
                    <MenuItem x:Name="ProfileWindow" Header="Profile"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12"
                          Command="{Binding Navigation.GoToProfileCommand}"/>
                </Menu>

                <Menu Grid.Column="6" HorizontalAlignment="Center" Background="{x:Null}">
                    <MenuItem x:Name="LogoutWindow_Dashboard" 
                          Header="Logout"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12" 
                          Command="{Binding Navigation.LogoutCommand}"/>
                </Menu>

            </Grid>
            <DataGrid ItemsSource="{Binding table1List}" 
                          SelectedItem="{Binding SelectedItem}"                   
                          AlternatingRowBackground="#22FFFFFF"  
                          RowBackground="Transparent"
                          AutoGenerateColumns="True"
                          CanUserAddRows="False"
                          Margin="78,53,157,70" 
                          BorderBrush="#FFAC41CB" 
                          Background="{x:Null}" 
                          ColumnWidth="*"
                          Foreground="White" Grid.Row="2" RenderTransformOrigin="0.5,0.5">
                <DataGrid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleY="-0.231"/>
                        <RotateTransform/>
                        <TranslateTransform Y="-0.746"/>
                    </TransformGroup>
                </DataGrid.RenderTransform>
            </DataGrid>

            <Rectangle Grid.Column="1" HorizontalAlignment="Center" Height="333" Margin="0,79,0,0" Grid.Row="2" Stroke="Black" VerticalAlignment="Top" Width="199" Fill="#FF110C57"/>
            <TextBlock Grid.Column="1" HorizontalAlignment="Center" Height="24" Margin="0,93,0,0" Grid.Row="2" TextWrapping="Wrap" Text="Input Grades" VerticalAlignment="Top" Width="144" Foreground="White" FontFamily="Century Gothic" FontSize="20" FontWeight="Bold" TextAlignment="Center"/>
            <TextBlock Grid.Column="1" HorizontalAlignment="Left" Height="24" Margin="70,177,0,0" Grid.Row="2" TextWrapping="Wrap" VerticalAlignment="Top" Width="77" Foreground="White" FontFamily="Century Gothic"><Run Text="Subject"/><LineBreak/><Run/></TextBlock>
            <TextBlock Grid.Column="1" HorizontalAlignment="Left" Height="24" Margin="70,152,0,0" Grid.Row="2" TextWrapping="Wrap" VerticalAlignment="Top" Width="18" Foreground="White" FontFamily="Century Gothic"><Run Text="ID"/><LineBreak/><Run/><LineBreak/><Run/></TextBlock>
            <TextBlock Grid.Column="1" HorizontalAlignment="Left" Height="24" Margin="70,201,0,0" Grid.Row="2" TextWrapping="Wrap" VerticalAlignment="Top" Width="77" Foreground="White" FontFamily="Century Gothic" Text="Grades"/>
            <TextBlock Grid.Column="1" HorizontalAlignment="Left" Height="24" Margin="70,230,0,0" Grid.Row="2" TextWrapping="Wrap" VerticalAlignment="Top" Width="86" Foreground="White" FontFamily="Century Gothic" Text="DateReported"/>

            <TextBox x:Name="txtID"
                     Text="{Binding newAccount.ID}"
                     Grid.Column="1"
                     Margin="135,149,69,0"
                     Height="20"
                     VerticalAlignment="Top" Grid.Row="2"/>

            <TextBox x:Name="txtSubject"
                     Text="{Binding newAccount.Subject}"
                     Grid.Column="1"
                     Margin="135,174,69,0"
                     Height="20"
                     VerticalAlignment="Top" Grid.Row="2"/>

            <TextBox x:Name="txtGrades"
                     Text="{Binding newAccount.Grades}"
                     Grid.Column="1"
                     Margin="135,200,69,0"
                     Height="20"
                     VerticalAlignment="Top" Grid.Row="2"/>

            <DatePicker x:Name="dpDate"
                        SelectedDate="{Binding newAccount.DateReported}"
                        Grid.Column="1"
                        Margin="165,225,69,0"
                        Height="24"
                        VerticalAlignment="Top" Grid.Row="2"/>

            <Button Content="Add"
                    Command="{Binding SaveCommand}"
                    Grid.Column="1"
                    Margin="70,272,69,184" Grid.Row="2"
                    />
            <Button x:Name="deleteButton" 
                    Grid.Column="1" 
                    Content="Delete" 
                    HorizontalAlignment="Left" 
                    Margin="70,370,0,0" 
                    Grid.Row="2" 
                    VerticalAlignment="Top" 
                    Width="77" 
                    Command="{Binding DeleteCommand}" 
                    RenderTransformOrigin="0.229,0.882" 
                    Height="32"/>
            <Button x:Name="clearButton" 
                    Grid.Column="1" 
                    Content="Clear" 
                    HorizontalAlignment="Left" 
                    Margin="165,370,0,0" 
                    Grid.Row="2" 
                    VerticalAlignment="Top" 
                    Width="77" 
                    Command="{Binding ClearCommand}" 
                    RenderTransformOrigin="0.502,-0.932" Height="32" />
            <Button Content="Update"
                Command="{Binding UpdateCommand}"
                Grid.Column="1"
                Margin="71,320,69,134" Grid.Row="2" 
                    />
        </Grid>
        <TextBlock 
           Text="{Binding WelcomeMessage}"
            HorizontalAlignment="Left"
            Margin="39,52,0,0"
            TextWrapping="Wrap"
            VerticalAlignment="Top"
            Foreground="White" RenderTransformOrigin="0.5,0.5" Width="666" Height="66" FontFamily="Verdana" FontSize="22" FontWeight="Bold">
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>
    </Grid>

</Window>
