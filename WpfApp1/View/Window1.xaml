<Window x:Class="WpfApp1.View.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.View"
        mc:Ignorable="d"
        Title="Window1" Height="600" Width="1000" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*"/>
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="..\Images\backgroundImage.jpg"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="15"/>
            <RowDefinition Height="25"/>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="HomeButton" 
                    Grid.Column="0" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    BorderBrush="{x:Null}"
                    Command="{Binding Navigation.GoToMainDashboardCommand}"
                    Width="40" 
                    Height="40">
                <Button.Content>
                    <Image x:Name="HOME_PAGE_BUTTON" 
                           Source="../Images/P-removebg-preview.png" 
                           Width="30" 
                           Height="30"/>
                </Button.Content>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Menu Grid.Column="3" 
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="{x:Null}">
                <MenuItem x:Name="SubjectsWindow" 
                          Header="Subjects"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12" 
                          Command="{Binding Navigation.GoToSubjectsCommand}" FontFamily="Century Gothic"/>
            </Menu>

            <Menu Grid.Column="4" 
                  HorizontalAlignment="Center" 
                  VerticalAlignment="Center"
                  Background="{x:Null}">
                <MenuItem x:Name="GradesWindow" 
                          Header="Grades"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12" 
                          Command="{Binding Navigation.GoToGradesCommand}"/>
            </Menu>

            <Menu Grid.Column="5" 
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="{x:Null}">
                <MenuItem x:Name="ProfileWindow" Header="Profile"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12"
                          Command="{Binding Navigation.GoToProfileCommand}"/>
            </Menu>

            <Menu Grid.Column="6" 
                  HorizontalAlignment="Center" 
                  VerticalAlignment="Center"
                  Background="{x:Null}">
                <MenuItem x:Name="LogoutWindow_Dashboard" 
                          Header="Logout"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12" 
                          Command="{Binding Navigation.LogoutCommand}"/>
            </Menu>
        </Grid>

        <!-- ==================== CARDS ROW ==================== -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

            <!-- UNCHANGED: Total Subjects card -->
            <Border Background="#FF110C57" CornerRadius="10" Padding="30,20" Margin="20">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Total Subjects"
                               Foreground="White"
                               FontFamily="Century Gothic"
                               FontSize="14"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalSubjects}"
                               Foreground="White"
                               FontFamily="Century Gothic"
                               FontSize="40"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- UNCHANGED: Average Grade card -->
            <Border Background="#FF110C57" CornerRadius="10" Padding="30,20" Margin="20">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Average Grade"
                               Foreground="White"
                               FontFamily="Century Gothic"
                               FontSize="14"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AverageGrade}"
                               Foreground="White"
                               FontFamily="Century Gothic"
                               FontSize="40"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- NEW: Target Grade card -->
            <Border Background="#FF110C57" CornerRadius="10" Padding="30,20" Margin="20">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Target Grade"
                               Foreground="White"
                               FontFamily="Century Gothic"
                               FontSize="14"
                               HorizontalAlignment="Center"/>
                    <TextBox Text="{Binding TargetGrade, UpdateSourceTrigger=PropertyChanged}"
                             Width="100"
                             FontSize="32"
                             FontWeight="Bold"
                             TextAlignment="Center"
                             Margin="0,5,0,5"/>
                    <Button Content="Set Target"
                            Command="{Binding SaveTargetGradeCommand}"
                            FontFamily="Century Gothic"
                            FontSize="11"
                            Padding="8,3"/>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- NEW: Grade status message below the cards -->
        <TextBlock Text="{Binding GradeStatusMessage}"
                   Grid.Row="2"
                   Grid.ColumnSpan="2"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,20"
                   Foreground="White"
                   FontFamily="Century Gothic"
                   FontSize="13"/>

        <!-- UNCHANGED: Welcome message -->
        <TextBlock 
            Text="{Binding WelcomeMessage}"
            HorizontalAlignment="Left"
            Margin="37,20,0,0"
            Grid.Row="2"
            TextWrapping="Wrap"
            VerticalAlignment="Top"
            Foreground="White" RenderTransformOrigin="0.5,0.5" Width="496" Height="66" FontFamily="Verdana" FontSize="22" FontWeight="Bold">
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>

    </Grid>
</Window>