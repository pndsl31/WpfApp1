<Window x:Class="WpfApp1.View.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.View"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="131*"/>
            <ColumnDefinition Width="29*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="../Images/purple-aesthetic-3840x2160-17734.jpg"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height= "15"/>
            <RowDefinition Height= "25"/>
            <RowDefinition/>
            <RowDefinition Height=" 40"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Grid.ColumnSpan="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="HomeButton" 
                    Grid.Column="0" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    BorderBrush="{x:Null}"
                    Command="{Binding GoToMainDashboardCommand}"
                    Width="40" 
                    Height="40">
                <Button.Content>
                    <Image x:Name="HOME_PAGE_BUTTON" 
                           Source="../Images/P-removebg-preview.png" 
                           Width="30" 
                           Height="30"/>
                </Button.Content>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Button.Template>
            </Button>


            <Menu Grid.Column="3" 
                  HorizontalAlignment="Center" 
                  Background="{x:Null}">
                <MenuItem x:Name="SubjectsWindow" 
                          Header="Subjects"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12" 
                          Command="{Binding GoToSubjectsCommand}"/>
            </Menu>

            <Menu Grid.Column="4" 
                  HorizontalAlignment="Center" 
                  Background="{x:Null}">
                <MenuItem x:Name="GradesWindow" 
                          Header="Grades"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12" 
                          Command="{Binding GoToGradesCommand}"/>
            </Menu>

            <Menu Grid.Column="5" HorizontalAlignment="Center" Background="{x:Null}">
                <MenuItem x:Name="ProfileWindow" Header="Profile"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12"
                          Command="{Binding GoToProfileCommand}"/>
            </Menu>

            <Menu Grid.Column="6" HorizontalAlignment="Center" Background="{x:Null}">
                <MenuItem x:Name="LogoutWindow_Dashboard" 
                          Header="Logout"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12" 
                          Command="{Binding LogoutCommand}"/>
            </Menu>

        </Grid>
        <TextBox HorizontalAlignment="Left" Margin="328,91,0,0" Grid.Row="2" TextWrapping="Wrap" Text="MAIN DASHBOARD" VerticalAlignment="Top" Width="120"/>
        <TextBlock 
            Text="{Binding CurrentUser.Username, StringFormat='Welcome to the main Home Page, {0}'}"
            HorizontalAlignment="Left"
            Margin="37,20,0,0"
            Grid.Row="2"
            TextWrapping="Wrap"
            VerticalAlignment="Top"
            Foreground="White" RenderTransformOrigin="0.5,0.5" Width="531" Height="66" FontFamily="Verdana" FontSize="22" FontWeight="Bold">
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>


    </Grid>
</Window>
