<Window x:Class="WpfApp1.View.SubjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.View"
        mc:Ignorable="d"
        Title="SubjectsWindow" Height="600" Width="1000" WindowStartupLocation="CenterScreen" >
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="131*"/>
                <ColumnDefinition Width="29*"/>
            </Grid.ColumnDefinitions>
            <Grid.Background>
                <ImageBrush ImageSource="..\Images\backgroundImage.jpg"/>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height= "15"/>
                <RowDefinition Height= "25"/>
                <RowDefinition/>
                <RowDefinition Height=" 40"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1" Grid.ColumnSpan="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="HomeButton" 
                    Grid.Column="0" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    BorderBrush="{x:Null}"
                    Command="{Binding Navigation.GoToMainDashboardCommand}"
                    Width="40" 
                    Height="40">
                    <Button.Content>
                        <Image x:Name="HOME_PAGE_BUTTON" 
                           Source="../Images/P-removebg-preview.png" 
                           Width="30" 
                           Height="30"/>
                    </Button.Content>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>


                <Menu Grid.Column="3" 
                  HorizontalAlignment="Center" 
                  Background="{x:Null}">
                    <MenuItem x:Name="SubjectsMenu" 
                          Header="Subjects"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12" 
                          />
                </Menu>

                <Menu Grid.Column="4" 
                  HorizontalAlignment="Center" 
                  Background="{x:Null}">
                    <MenuItem x:Name="GradesWindow" 
                          Header="Grades"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12" 
                          Command="{Binding Navigation.GoToGradesCommand}"/>
                </Menu>

                <Menu Grid.Column="5" HorizontalAlignment="Center" Background="{x:Null}">
                    <MenuItem x:Name="ProfileWindow" Header="Profile"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12"
                          Command="{Binding Navigation.GoToProfileCommand}"/>
                </Menu>

                <Menu Grid.Column="6" HorizontalAlignment="Center" Background="{x:Null}">
                    <MenuItem x:Name="LogoutWindow_Dashboard" 
                          Header="Logout"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12" 
                          Command="{Binding Navigation.LogoutCommand}"/>
                </Menu>

            </Grid>
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding SubjectList}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"                  
                      AlternatingRowBackground="#22FFFFFF"                  
                      Background="Transparent"                 
                      Foreground="White"                  
                      BorderBrush="#FFAC41CB"                  
                      Margin="37,60,27,46"                 
                      RowBackground="Transparent"      
                      GridLinesVisibility="None">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Subject"  Binding="{Binding Name}"     Width="*"/>
                    <DataGridTextColumn Header="Schedule" Binding="{Binding Schedule}" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock 
            Text="{Binding WelcomeMessage}"
            HorizontalAlignment="Left"
            Grid.Row="2"
            Margin="37,20,0,0"
            TextWrapping="Wrap"
            VerticalAlignment="Top"
            Foreground="White" RenderTransformOrigin="0.5,0.5" Width="706" Height="66" FontFamily="Verdana" FontSize="22" FontWeight="Bold">
                <TextBlock.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
