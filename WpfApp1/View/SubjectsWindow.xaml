<Window x:Class="WpfApp1.View.SubjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.View"
        mc:Ignorable="d"
        Title="SubjectsWindow" Height="700" Width="1000" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="131*"/>
                <ColumnDefinition Width="29*"/>
            </Grid.ColumnDefinitions>
            <Grid.Background>
                <ImageBrush ImageSource="..\Images\backgroundImage.jpg"/>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="15"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="200"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- UNCHANGED: Nav bar -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="HomeButton" 
                        Grid.Column="0" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        BorderBrush="{x:Null}"
                        Command="{Binding Navigation.GoToMainDashboardCommand}"
                        Width="40" 
                        Height="40">
                    <Button.Content>
                        <Image x:Name="HOME_PAGE_BUTTON" 
                               Source="../Images/P-removebg-preview.png" 
                               Width="30" 
                               Height="30"/>
                    </Button.Content>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Menu Grid.Column="3" HorizontalAlignment="Center" Background="{x:Null}">
                    <MenuItem x:Name="SubjectsMenu" 
                              Header="Subjects"
                              Foreground="White"
                              FontWeight="Bold"
                              FontSize="12"/>
                </Menu>

                <Menu Grid.Column="4" HorizontalAlignment="Center" Background="{x:Null}">
                    <MenuItem x:Name="GradesWindow" 
                              Header="Grades"
                              Foreground="White"
                              FontWeight="Bold"
                              FontSize="12" 
                              Command="{Binding Navigation.GoToGradesCommand}"/>
                </Menu>

                <Menu Grid.Column="5" HorizontalAlignment="Center" Background="{x:Null}">
                    <MenuItem x:Name="ProfileWindow" 
                              Header="Profile"
                              Foreground="White"
                              FontWeight="Bold"
                              FontSize="12"
                              Command="{Binding Navigation.GoToProfileCommand}"/>
                </Menu>

                <Menu Grid.Column="6" HorizontalAlignment="Center" Background="{x:Null}">
                    <MenuItem x:Name="LogoutWindow_Dashboard" 
                              Header="Logout"
                              Foreground="White"
                              FontWeight="Bold"
                              FontSize="12" 
                              Command="{Binding Navigation.LogoutCommand}"/>
                </Menu>
            </Grid>

            <!-- UNCHANGED: Welcome message -->
            <TextBlock 
                Text="{Binding WelcomeMessage}"
                HorizontalAlignment="Left"
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Margin="37,5,0,0"
                TextWrapping="Wrap"
                VerticalAlignment="Top"
                Foreground="White"
                Width="706"
                Height="30"
                FontFamily="Verdana"
                FontSize="22"
                FontWeight="Bold"/>

            <!-- UNCHANGED: Subjects table — just shrunk to fit Row 2 -->
            <DataGrid Grid.Row="2"
                      Grid.ColumnSpan="2"
                      ItemsSource="{Binding SubjectList}"
                      AlternatingRowBackground="#22FFFFFF"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      Background="Transparent"
                      Foreground="White"
                      BorderBrush="#FFAC41CB"
                      Margin="37,40,27,5"
                      RowBackground="Transparent"
                      GridLinesVisibility="None">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Subject"
                                        Binding="{Binding Name}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Schedule"
                                        Binding="{Binding Schedule}"
                                        Width="200"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- NEW: Deadlines section label -->
            <TextBlock
                Text="Deadlines"
                Grid.Row="3"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="37,8,0,0"
                Foreground="White"
                FontFamily="Verdana"
                FontSize="16"
                FontWeight="Bold"/>

            <!-- NEW: Activities/Deadlines table -->
            <DataGrid Grid.Row="3"
                      Grid.ColumnSpan="2"
                      ItemsSource="{Binding ActivityList}"
                      SelectedItem="{Binding SelectedActivity}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      AlternatingRowBackground="#22FFFFFF"
                      Background="Transparent"
                      Foreground="White"
                      BorderBrush="#FFAC41CB"
                      Margin="37,35,27,5"
                      RowBackground="Transparent"
                      GridLinesVisibility="None">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Subject"
                                        Binding="{Binding SubjectName}"
                                        Width="120"/>
                    <DataGridTextColumn Header="Activity"
                                        Binding="{Binding ActivityTitle}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Date Posted"
                                        Binding="{Binding DatePosted, StringFormat=\{0:MM/dd/yyyy\}}"
                                        Width="100"/>
                    <DataGridTextColumn Header="Deadline"
                                        Binding="{Binding Deadline, StringFormat=\{0:MM/dd/yyyy\}}"
                                        Width="100"/>
                    <DataGridCheckBoxColumn Header="Done"
                                            Binding="{Binding IsCompleted}"
                                            Width="50"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- NEW: Add activity input bar at the bottom -->
            <Border Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Background="#CC110C57"
                    Padding="10,5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <TextBox Text="{Binding NewActivity.SubjectName, UpdateSourceTrigger=PropertyChanged}"
                             Width="120"
                             Height="24"
                             Margin="5,0"
                             FontFamily="Century Gothic"
                             ToolTip="Subject Name"/>

                    <TextBox Text="{Binding NewActivity.ActivityTitle, UpdateSourceTrigger=PropertyChanged}"
                             Width="180"
                             Height="24"
                             Margin="5,0"
                             FontFamily="Century Gothic"
                             ToolTip="Activity Title"/>

                    <DatePicker SelectedDate="{Binding NewActivity.Deadline}"
                                Width="130"
                                Height="24"
                                Margin="5,0"
                                ToolTip="Deadline Date"/>

                    <Button Content="Add"
                            Command="{Binding AddActivityCommand}"
                            Height="24"
                            Margin="5,0"
                            Padding="10,0"
                            FontFamily="Century Gothic"/>

                    <Button Content="Mark Done"
                            Command="{Binding ToggleCompleteCommand}"
                            Height="24"
                            Margin="5,0"
                            Padding="10,0"
                            FontFamily="Century Gothic"/>

                    <Button Content="Delete"
                            Command="{Binding DeleteActivityCommand}"
                            Height="24"
                            Margin="5,0"
                            Padding="10,0"
                            FontFamily="Century Gothic"/>

                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Window>