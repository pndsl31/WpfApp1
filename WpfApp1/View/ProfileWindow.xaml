<Window x:Class="WpfApp1.View.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.View"
        mc:Ignorable="d"
        Title="ProfileWindow" Height="600" Width="1000" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="131*"/>
            <ColumnDefinition Width="29*"/>
        </Grid.ColumnDefinitions>

        <Grid.Background>
            <ImageBrush ImageSource="..\Images\backgroundImage.jpg"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="15"/>
            <RowDefinition Height="25"/>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="HomeButton" 
                    Grid.Column="0" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    BorderBrush="{x:Null}"
                    Command="{Binding Navigation.GoToMainDashboardCommand}"
                    Width="40" 
                    Height="40">
                <Button.Content>
                    <Image x:Name="HOME_PAGE_BUTTON" 
                           Source="../Images/P-removebg-preview.png" 
                           Width="30" 
                           Height="30"/>
                </Button.Content>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Button.Template>
            </Button>


            <Menu Grid.Column="3" 
                  HorizontalAlignment="Center" 
                  Background="{x:Null}">
                <MenuItem x:Name="SubjectsMenu" 
                          Header="Subjects"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12" 
                          Command="{Binding Navigation.GoToSubjectsCommand}"/>
            </Menu>

            <Menu Grid.Column="4" 
                  HorizontalAlignment="Center" 
                  Background="{x:Null}">
                <MenuItem x:Name="GradesMenu" 
                          Header="Grades"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12" 
                          Command="{Binding Navigation.GoToGradesCommand}"/>
            </Menu>

            <Menu Grid.Column="5" HorizontalAlignment="Center" Background="{x:Null}">
                <MenuItem x:Name="ProfileMenu" Header="Profile"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12"
                          />
            </Menu>

            <Menu Grid.Column="6" HorizontalAlignment="Center" Background="{x:Null}">
                <MenuItem x:Name="LogoutWindow_Dashboard" 
                          Header="Logout"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12" 
                          Command="{Binding Navigation.LogoutCommand}"/>
            </Menu>
        </Grid>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="450">

            <Border Width="80" Height="80"
            CornerRadius="40"
            Background="#FF110C57"
            HorizontalAlignment="Center"
            Margin="0,0,0,15">
                <TextBlock Text="👤"
                   FontSize="40"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
            </Border>

            <Border Background="#CC110C57" CornerRadius="10" Padding="30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Username:"    
                               Foreground="White" 
                               FontFamily="Century Gothic" 
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" 
                               Text="Student ID:"  
                               Foreground="White"                              
                               FontFamily="Century Gothic" 
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" 
                               Text="Course:"      
                               Foreground="White" 
                               FontFamily="Century Gothic" 
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" 
                               Text="Year/Section:" 
                               Foreground="White" 
                               FontFamily="Century Gothic" 
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" 
                               Text="Email:"       
                               Foreground="White" 
                               FontFamily="Century Gothic" 
                               VerticalAlignment="Center"/>

                    <TextBlock 
                        Grid.Row="0" 
                        Grid.Column="1" 
                        Text="{Binding CurrentUser.Username}" 
                        Foreground="White" 
                        FontFamily="Century Gothic" 
                        VerticalAlignment="Center"/>
                    <TextBlock 
                        Grid.Row="1" 
                        Grid.Column="1" 
                        Text="{Binding StudentId}"            
                        Foreground="White" 
                        FontFamily="Century Gothic" 
                        VerticalAlignment="Center"/>
                    <TextBlock 
                        Grid.Row="2" 
                        Grid.Column="1" 
                        Text="{Binding Course}"               
                        Foreground="White" 
                        FontFamily="Century Gothic" 
                        VerticalAlignment="Center"/>
                    <TextBlock 
                        Grid.Row="3" 
                        Grid.Column="1" 
                        Text="{Binding YearSection}"          
                        Foreground="White" 
                        FontFamily="Century Gothic" 
                        VerticalAlignment="Center"/>
                    <TextBlock 
                        Grid.Row="4" 
                        Grid.Column="1" 
                        Text="{Binding Email}"                
                        Foreground="White" 
                        FontFamily="Century Gothic" 
                        VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </StackPanel>
        <TextBlock 
            Text="{Binding WelcomeMessage}"
            Grid.Row="2"
            HorizontalAlignment="Left"
            Margin="37,20,0,0"
            TextWrapping="Wrap"
            VerticalAlignment="Top"
            Foreground="White" RenderTransformOrigin="0.5,0.5" Width="693" Height="66" FontFamily="Verdana" FontSize="22" FontWeight="Bold">
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>

    </Grid>
</Window>