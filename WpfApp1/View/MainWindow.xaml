<Window x:Class="WpfApp1.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.View"
        mc:Ignorable="d"
        Title="Poodle" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Background>
        <ImageBrush ImageSource="..\Images\backgroundImage.jpg" Stretch="UniformToFill"/>
    </Window.Background>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Century Gothic"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="#CC77FF"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"  Value="#9B4FDE"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#EE99FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background"  Value="#5B1F9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <Rectangle Fill="#55000000"/>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="370"
                CornerRadius="16"
                Padding="40,36,40,40">
            <Border.Background>
                <SolidColorBrush Color="#EE0D0A2E"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#AC41CB" BlurRadius="40" ShadowDepth="0" Opacity="0.55"/>
            </Border.Effect>

            <StackPanel>

                <Image Source="../Images/P-removebg-preview.png"
                       Height="68" Width="68"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6"/>

                <TextBlock HorizontalAlignment="Center"
                           FontFamily="Cascadia Code SemiBold"
                           FontStyle="Italic"
                           FontWeight="UltraBold"
                           FontSize="38"
                           Margin="0,0,0,2">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="White"   Offset="0"/>
                            <GradientStop Color="#CC77FF" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                    Poodle
                </TextBlock>

                <TextBlock Text="Student Personal Portal"
                           HorizontalAlignment="Center"
                           FontFamily="Century Gothic"
                           FontSize="11"
                           Foreground="#9988BB"
                           Margin="0,0,0,28"/>

                <TextBlock Text="USERNAME"
                           FontFamily="Century Gothic"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#9988BB"
                           Margin="0,0,0,5"/>

                <Border CornerRadius="8" BorderBrush="#AC41CB" BorderThickness="1" Margin="0,0,0,16">
                    <Border.Background>
                        <SolidColorBrush Color="#221450"/>
                    </Border.Background>
                    <TextBox x:Name="UsernameTextBox"
                             Text="{Binding CurrentUser.Username, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             Foreground="White"
                             CaretBrush="White"
                             FontFamily="Century Gothic"
                             FontSize="14"
                             Height="40"
                             Padding="12,0"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"/>
                </Border>

                <TextBlock Text="PASSWORD"
                           FontFamily="Century Gothic"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#9988BB"
                           Margin="0,0,0,5"/>

                <Border CornerRadius="8" BorderBrush="#AC41CB" BorderThickness="1" Margin="0,0,0,28">
                    <Border.Background>
                        <SolidColorBrush Color="#221450"/>
                    </Border.Background>
                    <PasswordBox x:Name="PasswordTextBox"
                                 Background="Transparent"
                                 Foreground="White"
                                 CaretBrush="White"
                                 FontFamily="Century Gothic"
                                 FontSize="14"
                                 Height="40"
                                 Padding="12,0"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"/>
                </Border>

                <Button Content="LOG IN"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=PasswordTextBox}"
                        Height="44"
                        FontSize="14"
                        Padding="0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#7B2FBE" Offset="0"/>
                            <GradientStop Color="#AC41CB" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

            </StackPanel>
        </Border>

    </Grid>
</Window>