<Window x:Class="WpfApp1.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="ProfileWindow" Height="450" Width="800" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="131*"/>
            <ColumnDefinition Width="29*"/>
        </Grid.ColumnDefinitions>

        <Grid.Background>
            <ImageBrush ImageSource="C:\Users\Robert\Desktop\SV\College\2nd year\2nd sem\programming\purple-aesthetic-2880x1800-17734.jpg"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="15"/>
            <RowDefinition Height="25"/>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="HomeButton" 
                    Grid.Column="0" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    BorderBrush="{x:Null}"
                    Click="HomeButton_Click"
                    Width="40" 
                    Height="40">
                <Button.Content>
                    <Image x:Name="HOME_PAGE_BUTTON" 
                           Source="C:\Users\Robert\Desktop\SV\College\2nd year\2nd sem\programming\P_logo-removebg-preview.png" 
                           Width="30" 
                           Height="30"/>
                </Button.Content>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Menu Grid.Column="3" HorizontalAlignment="Center" Background="{x:Null}">
                <MenuItem x:Name="SubjectsMenu" Header="Subjects"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12" Click="SubjectsWindow_Click"/>
            </Menu>

            <Menu Grid.Column="4" HorizontalAlignment="Center" Background="{x:Null}">
                <MenuItem x:Name="GradesMenu" Header="Grades"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12" Click="GradesWindow_Click"/>
            </Menu>


            <Menu Grid.Column="5" HorizontalAlignment="Center" Background="{x:Null}">
                <MenuItem x:Name="ProfileMenu" Header="Profile"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12" Click="ProfileWindow_Click"/>
            </Menu>

            <Menu Grid.Column="6" HorizontalAlignment="Center" Background="{x:Null}">
                <MenuItem x:Name="LogoutMenu" Header="Logout"
                          Foreground="White"
                          FontWeight="Bold"
                          FontSize="12" Click="LogoutWindow_Dashboard_Click"/>
            </Menu>
        </Grid>

        <TextBox HorizontalAlignment="Left" Margin="328,170,0,0" Grid.Row="2" 
                 TextWrapping="Wrap" Text="PROFILE DASHBOARD" VerticalAlignment="Top" Width="173"/>
    </Grid>
</Window>